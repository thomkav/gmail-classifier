# 1Password references for Gmail app passwords — safe to commit (no secret values).
# Resolved at runtime via `op run --account my.1password.com --env-file=.env.op -- <cmd>`.
# Vault: gmail-classifier (my.1password.com)

GMAIL_APP_PASSWORD_THOMKAV_AT_GMAIL_COM=op://gmail-classifier/37lqsgmzq2bv5niq5y7badbr5m/password
GMAIL_APP_PASSWORD_THOMAS_KAVANAGH_DEV_AT_GMAIL_COM=op://gmail-classifier/lxygbfgg2d66aqjelgth6772c4/password

# Legacy unsuffixed vars — scripts/*.py (sender_audit, auto_archive, mass_archive,
# extract_unsubscribe, batch_archive, sweep_blocked, inbox_audit, archive_old) still
# read these directly and default GMAIL_EMAIL to thomkav@gmail.com, matching the
# accounts table's is_default row. Keep in sync if the default account changes.
GMAIL_APP_PASSWORD=op://gmail-classifier/37lqsgmzq2bv5niq5y7badbr5m/password
GMAIL_EMAIL=thomkav@gmail.com
